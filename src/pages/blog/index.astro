---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagline = site.tagline;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base nav="blog" title={`Blog — ${site.name}`} description={`Writing by ${site.name} on speech, audio LLMs, and real-time voice systems.`}>
  <div class="shell">
    <Sidebar tagline={tagline} />

    <main id="main">
      <section class="sec">
        <div class="sec-eyebrow">WRITING</div>
        <h2 class="sec-title">Blog</h2>

        {
          posts.length === 0 ? (
            <p style="color: var(--fg-2); font-size: 0.95rem;">
              Nothing new here yet — notes on speech, audio LLMs, and building real-time voice
              systems are on the way.
            </p>
          ) : (
            posts.map((post) => (
              <article class="post-card">
                <div class="d">{fmtDate(post.data.date)}</div>
                <h3>
                  <a href={post.data.external ?? `/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="tags">
                    {post.data.tags.map((t: string) => (
                      <span>{t}</span>
                    ))}
                  </div>
                )}
              </article>
            ))
          )
        }
      </section>


      <footer class="site-footer">
        © {new Date().getFullYear()} Cheng-I Jeff Lai ·
        <a href="/">Home</a> ·
        <a href={site.links.github}>GitHub</a> ·
        <a href="/rss.xml">RSS</a>
      </footer>
    </main>
  </div>
</Base>
