---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft && !p.data.external)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base nav="blog" title={`${post.data.title} — ${site.name}`} description={post.data.description}>
  <div class="shell" style="grid-template-columns: 1fr;">
    <main id="main" style="max-width: 44rem; margin: 0 auto; width: 100%;">
      <article>
        <header class="post-head">
          <div class="d">{fmtDate(post.data.date)}</div>
          <div class="prose">
            <h1>{post.data.title}</h1>
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>
      </article>

      <a class="back-link" href="/blog/">← All posts</a>

      <footer class="site-footer">
        © {new Date().getFullYear()} Cheng-I Jeff Lai ·
        <a href="/">Home</a> ·
        <a href="/rss.xml">RSS</a>
      </footer>
    </main>
  </div>
</Base>
