---
import Base from '../layouts/Base.astro';
import { comparison, cohorts } from '../data/tts-comparison';
import TtsLatency from '../components/TtsLatency.astro';

const { models, voices, paragraphs } = comparison;
const firstParagraph = paragraphs[0];
const initial = (voiceId: string, modelId: string) => comparison.records.find(r => r.voiceId === voiceId && r.modelId === modelId && r.paragraphId === firstParagraph.id)!;
const ms = (value: number) => Math.round(value).toLocaleString('en-US');
const seconds = (value: number) => (value / 1000).toFixed(2);
const tags = [
  { title: 'Emotion', examples: ['[excited]', '[curious]', '[sarcastic]', '[crying]'] },
  { title: 'Delivery & pacing', examples: ['[whispers]', '[shouts]', '[softly]', '[slowly]', '[rushed]', '[pause]'] },
  { title: 'Vocal reactions', examples: ['[laughs]', '[sighs]', '[exhales]', '[snorts]', '[clears throat]'] },
  { title: 'Sound effects', examples: ['[applause]', '[clapping]', '[gunshot]', '[explosion]'] },
  { title: 'Experimental', examples: ['[sings]', '[strong American accent]', '[strong French accent]'] },
];
---

<Base
  nav="tts"
  noindex
  title="Mandarin & English voice comparison — Cheng-I Jeff Lai"
  description="Seven voices, twenty Mandarin and ten English passages, with Eleven v3 and v3 Conversational side by side."
>
  <main id="main" class="tts-page">
    <header class="tts-intro">
      <p class="eyebrow">SPEECH / LISTENING ROOM</p>
      <h1>Mandarin & English voices</h1>
      <p class="intro-text">Seven voices. Thirty passages. Both v3 models, side by side.</p>
      <div class="sample-meta">
        <span>Taiwanese Mandarin + English</span><span>{comparison.records.length} audio samples</span>
        <time datetime={comparison.generatedOn}>September 25, 2026</time>
      </div>
      <nav class="section-links" aria-label="On this page">
        <a href="#listen">Listen & compare</a><a href="#latency">Latency benchmark</a><a href="#audio-tags">Audio tags</a>
      </nav>
    </header>

    <section id="listen" class="comparison-layout" aria-label="Listen and compare voices">
      <aside class="sample-context">
        <div class="passage-controls">
        <div class="selector">
          <label for="tts-paragraph" class="eyebrow">PASSAGE</label>
          <select id="tts-paragraph" disabled>
            {cohorts.map(cohort => <optgroup label={`${cohort.label} · ${cohort.benchmark.paragraphs.length} passages`} lang={cohort.language}>
              {cohort.benchmark.paragraphs.map((paragraph, index) => <option value={paragraph.id}>{String(index + 1).padStart(2, '0')} · {paragraph.title}</option>)}
            </optgroup>)}
          </select>
        </div>
        <div class="passage-navigation" data-passage-navigation hidden>
          <button type="button" data-previous disabled aria-label="Previous passage">← Previous</button>
          <span data-passage-count>01 / {paragraphs.length}</span>
          <button type="button" data-next aria-label="Next passage">Next →</button>
        </div>
        <p class="listening-note">Changing the passage updates both models for every voice and stops playback.</p>
        <noscript><p class="listening-note">Enable JavaScript to switch passages. Both models for the first passage are playable below.</p></noscript>
        </div>
        <div class="passage-text">
        <p class="passage-category" data-passage-category>{firstParagraph.languageLabel} · {firstParagraph.category} · {firstParagraph.sentences} sentences</p>
        <blockquote id="sample-transcript" lang="zh-Hant-TW">{firstParagraph.text}</blockquote>
        <p class="listening-note" data-generation-note>Both models receive the same text, without audio tags. Each pair plays Eleven v3 first, then v3 Conversational.</p>
        </div>
      </aside>

      <div class="samples">
        <div class="samples-toolbar">
          <h2>Listen & compare <span>07 voices · 02 models per voice</span></h2>
          <button type="button" class="play-all" data-play-all hidden>Play all pairs</button>
        </div>
        <p class="playback-status" data-playback-status role="status" aria-live="polite">Choose a voice below to start listening.</p>
        <ol id="voice-samples" class="voice-list">
          {voices.map((voice, index) => (
            <li class="voice-row" data-voice-row data-voice-id={voice.id}>
              <span class="voice-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="voice-content">
                <div class="voice-heading">
                  <div>
                  <h3 id={`voice-${voice.id}`}>{voice.label}</h3>
                  <p class="voice-description">{voice.description}</p>
                  </div>
                  <div class="voice-actions">
                    <a href={`https://elevenlabs.io/voices/${voice.id}`} target="_blank" rel="noopener noreferrer">Voice profile ↗</a>
                    <button type="button" class="play-pair" data-play-pair aria-label={`Play both models for ${voice.label}`} hidden>Play pair</button>
                  </div>
                </div>
                <div class="model-pair">
                  {models.map(model => {
                    const sample = initial(voice.id, model.id);
                    const labelId = `model-${voice.id}-${model.id}`;
                    return <section class="model-sample" data-model-sample data-model-id={model.id} aria-labelledby={`voice-${voice.id} ${labelId}`}>
                      <div class="model-heading">
                        <h4 id={labelId}>{model.label} {model.id === comparison.defaultModelId && <span class="default-badge">Default</span>}</h4>
                        <span class="duration" data-duration>{sample.durationSeconds.toFixed(2)}s audio</span>
                      </div>
                      <audio controls preload="metadata" src={sample.audioPath} aria-labelledby={`voice-${voice.id} ${labelId}`} aria-describedby="sample-transcript" data-voice-name={voice.label} data-model-name={model.label}>
                        Your browser does not support audio playback.
                      </audio>
                      <div class="clip-timing"><span>First byte <b data-ttfb>{ms(sample.ttfbMs)} ms</b></span><span>Full request <b data-total>{seconds(sample.totalMs)} s</b></span></div>
                      <div class="voice-links"><a href={sample.audioPath} data-download download aria-label={`Download ${voice.label} — ${model.label} MP3`}>Download MP3 ↓</a></div>
                    </section>;
                  })}
                </div>
              </div>
            </li>
          ))}
        </ol>
        <p class="sample-caption">AI-generated speech. Original, unedited MP3s. Timings are from generation, not playback on this page.</p>
        <p class="listening-note" data-identity-note>v3 Conversational may not preserve the identity of these professional voice clones. <a href="https://elevenlabs.io/docs/eleven-agents/customization/voice/expressive-mode#limitations" target="_blank" rel="noopener noreferrer">ElevenLabs explains ↗</a></p>
      </div>
    </section>

    <section id="latency" class="report-section" aria-labelledby="latency-heading">
      <p class="eyebrow">THE MEASUREMENTS</p>
      <h2 id="latency-heading">Latency, side by side</h2>
      <div class="benchmark-selector">
        <label for="tts-benchmark-language">Benchmark language</label>
        <select id="tts-benchmark-language" disabled>
          {cohorts.map(cohort => <option value={cohort.language}>{cohort.label} · {cohort.benchmark.paragraphs.length} passages</option>)}
        </select>
      </div>
      <p class="listening-note">English and Mandarin results are kept separate. Selecting a passage shows its language here; you can also switch the benchmark independently.</p>
      {cohorts.map((cohort, index) => <TtsLatency {...cohort} hidden={index > 0} />)}
    </section>

    <section id="audio-tags" class="report-section" aria-labelledby="tags-heading">
      <p class="eyebrow">EXPRESSIVE CONTROL</p>
      <h2 id="tags-heading">Audio tags for v3</h2>
      <p class="section-description">Place a direction in square brackets before the words it should affect. These are documented examples, not a fixed or exhaustive list; the result depends on the voice and context.</p>
      <div class="tag-list">
        {tags.map(group => <div class="tag-group"><h3>{group.title}</h3><div>{group.examples.map(tag => <code>{tag}</code>)}</div></div>)}
      </div>
      <div class="tag-example"><p class="eyebrow">EXAMPLE PROMPT</p><p lang="zh-Hant-TW"><code>[curious]</code> 你有沒有想過，為什麼有些歌一響起，就會讓人想起某段回憶？<br /><code>[softly]</code> 明明過了好多年，卻還是記得那一天。</p></div>
      <p class="section-description">Natural stability (0.5) balances consistency and expression. Some voices respond more strongly than others; sound effects, accents, and singing are especially variable. v3 does not support SSML <code>&lt;break&gt;</code> tags.</p>
      <p class="section-description">v3 Conversational also supports expressive tags. Its guide lists <code>[laughs]</code>, <code>[whispers]</code>, <code>[sighs]</code>, <code>[slow]</code>, and <code>[excited]</code>, with effects lasting roughly the next 4–5 words. <a href="https://elevenlabs.io/docs/eleven-agents/customization/voice/expressive-mode#using-expressive-tags" target="_blank" rel="noopener noreferrer">Conversational tag guide ↗</a></p>
      <p class="section-description"><strong>Automatic tags with Enhance:</strong> in the ElevenLabs editor, select Eleven v3, enter your text, click Enhance, review the tags, then generate speech. Enhance uses an LLM to prepare the text. In this comparison, English inputs include <code>[strong American accent]</code> and Mandarin uses plain text. <a href="https://elevenlabs.io/docs/overview/capabilities/text-to-speech/best-practices#enhancing-input" target="_blank" rel="noopener noreferrer">How Enhance works ↗</a></p>
      <p class="source-links"><a href="https://elevenlabs.io/docs/overview/capabilities/text-to-speech/best-practices#prompting-eleven-v3" target="_blank" rel="noopener noreferrer">Official v3 prompting guide ↗</a><a href="https://elevenlabs.io/blog/v3-audiotags" target="_blank" rel="noopener noreferrer">Audio tag examples ↗</a></p>
    </section>

    <footer class="site-footer"><a href="/">Cheng-I Jeff Lai</a> · Speech experiments · <time datetime={comparison.generatedOn}>{comparison.generatedOn}</time></footer>
  </main>
  <script id="tts-data" type="application/json" set:html={JSON.stringify(comparison).replace(/</g, '\\u003c')} />
</Base>

<script>
  import '../scripts/tts-comparison';
</script>

<style>
  .tts-page { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
  .tts-intro { padding: 3.7rem 0 1.8rem; border-bottom: 1px solid var(--rule); }
  .eyebrow { display: block; margin: 0 0 0.8rem; font: 600 0.68rem var(--mono); letter-spacing: 0.13em; color: var(--accent); }
  h1 { margin: 0; font: 900 clamp(2rem, 4.8vw, 3.2rem)/1.15 var(--serif); letter-spacing: -0.035em; }
  h2 { margin: 0; font: 900 clamp(1.5rem, 3vw, 2rem)/1.25 var(--serif); letter-spacing: -0.02em; }
  h3 { margin: 0; font-size: 0.98rem; font-weight: 600; }
  .intro-text { margin: 1rem 0 1.1rem; color: var(--fg-2); font-size: 1.04rem; }
  .sample-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; font: 0.71rem/1.6 var(--mono); color: var(--fg-3); }
  .section-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin-top: 1.6rem; font-size: 0.8rem; }
  .comparison-layout { padding-top: 2.5rem; }
  .sample-context { display: grid; grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr); gap: 3rem; padding-bottom: 2rem; }
  select { width: 100%; min-width: 0; padding: 0.75rem 0.6rem; border: 1px solid var(--rule); border-radius: 4px; background: var(--card); color: var(--fg); font: 0.9rem var(--sans); }
  select:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  button { cursor: pointer; font-family: var(--sans); }
  .passage-navigation { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-top: 0.75rem; }
  [hidden] { display: none !important; }
  .passage-navigation button { background: none; border: 0; color: var(--accent); padding: 0.5rem 0; font-size: 0.78rem; }
  .passage-navigation button:disabled { color: var(--fg-3); opacity: 0.65; cursor: default; }
  .passage-navigation span { font: 0.68rem var(--mono); color: var(--fg-3); }
  .passage-category { margin: 0; font: 0.69rem/1.7 var(--mono); color: var(--fg-3); }
  blockquote { margin: 0.9rem 0 1.3rem; font-family: 'PingFang TC', 'Microsoft JhengHei', var(--sans); font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 500; line-height: 1.95; letter-spacing: 0.015em; }
  .listening-note { margin: 0.8rem 0 0; color: var(--fg-3); font-size: 0.79rem; line-height: 1.8; }
  .samples { min-width: 0; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .samples-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .samples-toolbar h2 { font-size: 1.2rem; }
  .samples-toolbar h2 span { display: block; margin-top: 0.35rem; font: 0.66rem/1.5 var(--mono); color: var(--fg-3); letter-spacing: 0; }
  .play-all { flex-shrink: 0; border: 1px solid var(--accent); background: var(--accent); color: var(--bg); padding: 0.65rem 0.9rem; border-radius: 4px; font-size: 0.77rem; font-weight: 600; }
  .play-all:hover { background: var(--accent-2); border-color: var(--accent-2); }
  .playback-status { min-height: 2.6em; margin: 0.9rem 0 0; color: var(--fg-3); font-size: 0.74rem; }
  .voice-list { list-style: none; margin: 0; padding: 0; }
  .voice-row { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0.8rem; padding: 1.5rem 0; border-top: 1px solid var(--rule); }
  .voice-number { padding-top: 0.2rem; font: 0.72rem/1.5 var(--mono); color: var(--fg-3); }
  .voice-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem 1rem; margin-bottom: 0.9rem; }
  .voice-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem; font: 0.66rem/1.8 var(--mono); }
  .play-pair { border: 1px solid var(--accent); border-radius: 4px; background: transparent; color: var(--accent); padding: 0.5rem 0.8rem; font-size: 0.74rem; font-weight: 600; }
  .play-pair:hover { background: var(--bg-2); }
  .model-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .model-sample { min-width: 0; padding: 1rem; border: 1px solid var(--rule); border-radius: 4px; background: var(--card); transition: border-color 160ms ease, background 160ms ease; }
  .model-sample[data-playing] { border-color: var(--accent); background: var(--bg-2); }
  .model-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem 0.75rem; margin-bottom: 0.85rem; }
  .model-heading h4 { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin: 0; font-size: 0.85rem; font-weight: 600; }
  .default-badge { border: 1px solid var(--rule); border-radius: 3px; padding: 0.1rem 0.3rem; font: 0.58rem/1.5 var(--mono); color: var(--fg-3); }
  .duration { margin-left: auto; font: 0.65rem var(--mono); color: var(--fg-3); white-space: nowrap; }
  .voice-description { margin: 0.2rem 0 0; color: var(--fg-3); font-size: 0.78rem; }
  audio { display: block; width: 100%; height: 40px; }
  audio:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
  .clip-timing { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; margin-top: 0.65rem; font: 0.65rem/1.5 var(--mono); color: var(--fg-3); }
  .clip-timing b { color: var(--fg-2); font-weight: 500; }
  .voice-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-top: 0.5rem; font: 0.66rem/1.8 var(--mono); }
  .sample-caption { margin: 0.8rem 0 0; color: var(--fg-3); font-size: 0.72rem; line-height: 1.8; }
  .benchmark-selector { display: flex; align-items: center; flex-wrap: wrap; gap: 0.6rem 1rem; margin-top: 1.3rem; font-size: 0.8rem; color: var(--fg-2); }
  .benchmark-selector select { width: auto; max-width: 100%; }
  .report-section { padding-top: 3rem; margin-top: 3.5rem; border-top: 1px solid var(--rule); scroll-margin-top: 5rem; }
  .section-description { max-width: 80ch; color: var(--fg-2); margin: 1rem 0 1.7rem; font-size: 0.88rem; line-height: 1.8; }
  code { font: 0.75rem/1.6 var(--mono); overflow-wrap: anywhere; }
  .tag-list { border-top: 1px solid var(--rule); }
  .tag-group { display: grid; grid-template-columns: 12rem 1fr; gap: 0.75rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .tag-group h3 { padding-top: 0.3rem; font-size: 0.85rem; }
  .tag-group > div { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag-group code { background: var(--bg-2); border: 1px solid var(--rule); border-radius: 3px; padding: 0.2rem 0.5rem; color: var(--fg-2); }
  .tag-example { margin-top: 1.7rem; padding: 1.4rem; border-left: 2px solid var(--accent); background: var(--bg-2); }
  .tag-example > p:last-child { margin: 0; font-size: 0.98rem; line-height: 2.1; }
  .tag-example code { color: var(--accent); }
  .source-links { display: flex; flex-wrap: wrap; gap: 0.7rem 1.5rem; font-size: 0.78rem; }
  .site-footer { margin-top: 3rem; }
  .site-footer time { white-space: nowrap; }
  @media (max-width: 780px) {
    .sample-context { grid-template-columns: 1fr; gap: 1.5rem; }
    .tts-intro { padding-top: 2.6rem; }
    .tag-group { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .model-pair { grid-template-columns: 1fr; gap: 0.75rem; }
    .model-sample { padding: 0.85rem; }
  }
  @media (max-width: 480px) {
    .tts-page { padding: 0 1rem; }
    .tts-intro { padding-top: 2rem; }
    .sample-meta { gap: 0.35rem 1rem; font-size: 0.65rem; }
    .section-links { gap: 0.75rem 1rem; font-size: 0.72rem; }
    .comparison-layout { padding-top: 2rem; }
    .voice-row { gap: 0.5rem; padding-right: 0; }
    .duration { font-size: 0.6rem; }
    .play-all { padding: 0.65rem 0.7rem; }
    .samples-toolbar h2 { font-size: 1.07rem; }
    .tag-example { padding: 1rem; }
  }
</style>
