---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import GitHubGraph from '../components/GitHubGraph.astro';
import Icon from '../components/Icon.astro';
import { site, orgs, people } from '../data/site';
import { recentWork } from '../data/work';
import { selectedPublications } from '../data/publications';

import { getCollection } from 'astro:content';

const sections = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Recent work' },
  { href: '#publications', label: 'Publications' },
  { href: '#writing', label: 'Writing' },
];

const tagline = site.tagline;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPost = posts[0];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' })
    .replace(/(\d+)\/(\d+)\/(\d+)/, '$3-$1-$2');

/** Render an author list, emphasising Jeff's own name (wrapped in braces). */
const renderAuthors = (s: string) =>
  s.replace(/\{([^}]+)\}/g, '<span class="me">$1</span>');
---

<Base nav="home">
  <div class="shell">
    <Sidebar sections={sections} tagline={tagline} />

    <main id="main">
      {/* ─────────────────────────── about ─────────────────────────── */}
      <section class="sec about" id="about">
        <div class="sec-eyebrow">ABOUT</div>

        <p>
          I'm a speech researcher at <a href={orgs.meta}>Meta Superintelligence Labs</a>, based in
          the SF Bay Area and working on <strong>speech-to-speech LLMs</strong>. I lead user-memory
          post-training — data curation
          and evaluation — and co-lead the infra integration that carries it into
          <strong>Meta's voice products</strong>, so the assistant remembers you and personalizes
          its responses mid-stream.
        </p>

        <p>
          Before that I was at WaveForms AI (acquired by Meta), where I worked on audio-text MoE
          mid-training. At Google DeepMind I built
          <strong>Audio-Visual Gemma</strong>, a 3B/10B foundation-model family for natively
          visually-coherent speech generation.
        </p>

        <p>
          I finished my Ph.D. at MIT in 2025, advised by <a href={people.glass}>James Glass</a> in
          the <a href={orgs.sls}>Spoken Language Systems</a> group at CSAIL. My thesis was on
          language modeling from visually grounded speech; along the way I worked on sparse
          subnetworks in self-supervised speech (<a href="#publications">PARP</a>) and co-authored
          <a href="https://arxiv.org/abs/2105.01051">SUPERB</a>. Before that, my research was
          shaped by <a href={people.dehak}>Najim Dehak</a> and
          <a href={people.villalba}>Jesús Villalba</a> at <a href={orgs.jhu}>Johns Hopkins</a>,
          <a href={people.king}>Simon King</a> at <a href={orgs.edinburgh}>Edinburgh's CSTR</a>, and
          <a href={people.yamagishi}>Junichi Yamagishi</a> at <a href={orgs.nii}>NII</a> in Tokyo —
          on speaker recognition, anti-spoofing, and speech synthesis.
        </p>

        <GitHubGraph />
      </section>

      {/* ───────────────────────── recent work ─────────────────────── */}
      <section class="sec" id="work">
        <div class="sec-eyebrow">01 / RECENT WORK</div>
        <h2 class="sec-title">Recent work</h2>
        <ul class="work">
          {
            recentWork.map((w) => (
              <li class={w.featured ? 'featured' : undefined}>
                <div class="work-head">
                  <span class="work-name">{w.name}</span>
                  <span class="work-tagline">{w.tagline}</span>
                  <span class="work-date">{w.date}</span>
                </div>
                <p class="work-blurb">{w.blurb}</p>
                <div class="work-meta">
                  {w.tags?.map((t) => <span class="work-tag">{t}</span>)}
                  {
                    w.links && w.links.length > 0 && (
                      <span class="work-links">
                        {w.links.map((l) => (
                          <a href={l.href}>
                            <Icon name={l.href.endsWith('.pdf') ? 'file' : 'link'} size={12} /> {l.label}
                          </a>
                        ))}
                      </span>
                    )
                  }
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      {/* ───────────────────────── publications ────────────────────── */}
      <section class="sec" id="publications">
        <div class="sec-eyebrow">02 / RESEARCH</div>
        <div class="sec-title-row">
          <h2 class="sec-title">Selected publications</h2>
          <a class="sec-title-link" href={site.links.scholar}>
            <Icon name="scholar" size={13} /> Google Scholar
          </a>
        </div>

        <div class="scholar-stats">
          <div>
            <span class="n">{site.scholarStats.citations}</span>
            <span class="l">Citations</span>
          </div>
          <div>
            <span class="n">{site.scholarStats.hIndex}</span>
            <span class="l">h-index</span>
          </div>
          <div>
            <span class="n">{site.scholarStats.i10}</span>
            <span class="l">i10-index</span>
          </div>
          <span class="asof">Google Scholar, as of {site.scholarStats.asOf}</span>
        </div>

        <ul class="pubs">
          {
            selectedPublications.map((p) => (
              <li>
                <div class="pub-title">{p.title}</div>
                <span class="pub-authors" set:html={renderAuthors(p.authors)} />
                <div class="pub-meta">
                  <a class="venue-badge" href={p.page ?? p.arxiv ?? site.links.scholar}>
                    {p.venue} {p.year}
                  </a>
                  {p.honor && <span class="honor">{p.honor}</span>}
                  <span class="pub-links">
                    {p.arxiv && (
                      <a href={p.arxiv}>
                        <Icon name="arxiv" size={12} /> arxiv
                      </a>
                    )}
                    {p.code && (
                      <a href={p.code}>
                        <Icon name="code" size={12} /> code
                      </a>
                    )}
                    {p.page && (
                      <a href={p.page}>
                        <Icon name="link" size={12} /> page
                      </a>
                    )}
                  </span>
                  {p.citations && <span class="pub-cites">{p.citations.toLocaleString('en-US')} cites</span>}
                </div>
              </li>
            ))
          }
        </ul>

        <p class="pub-legend">* equal contribution</p>

        <div class="sec-more">
          <a href={site.links.scholar}>Full publication list on Google Scholar →</a>
        </div>
      </section>

      {/* ─────────────────────────── writing ───────────────────────── */}
      <section class="sec" id="writing">
        <div class="sec-eyebrow">03 / WRITING</div>
        <h2 class="sec-title">Blog</h2>

        {
          latestPost ? (
            <article class="post-card">
              <div class="d">{fmtDate(latestPost.data.date)}</div>
              <h3>
                <a href={`/blog/${latestPost.id}/`}>{latestPost.data.title}</a>
              </h3>
              <p>{latestPost.data.description}</p>
              {latestPost.data.tags && latestPost.data.tags.length > 0 && (
                <div class="tags">
                  {latestPost.data.tags.map((t: string) => (
                    <span>{t}</span>
                  ))}
                </div>
              )}
            </article>
          ) : (
            <p style="color: var(--fg-2); font-size: 0.92rem;">
              Notes on speech, audio LLMs, and building real-time voice systems — coming soon.
            </p>
          )
        }

        <div class="sec-more">
          <a href="/blog/">All posts →</a>
        </div>
      </section>

      <footer class="site-footer">
        © {new Date().getFullYear()} Cheng-I Jeff Lai ·
        <a href={site.links.github}>GitHub</a> ·
        <a href={site.links.scholar}>Scholar</a> ·
        <a href="/rss.xml">RSS</a>
      </footer>
    </main>
  </div>
</Base>
