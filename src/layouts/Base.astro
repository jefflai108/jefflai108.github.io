---
import '../styles/global.css';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  /** which top-nav item is current */
  nav?: 'home' | 'blog';
}

const {
  title = site.name,
  description = `${site.name} — ${site.role} at ${site.org}. Real-time speech-to-speech and audio-text LLM systems.`,
  nav = 'home',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.avatar, site.url).toString()} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,900&display=swap"
    />

    {/* Set the theme before first paint so there is no light/dark flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (stored === null &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        alternateName: 'Jeff Lai',
        url: site.url,
        image: new URL(site.avatar, site.url).toString(),
        email: `mailto:${site.email}`,
        jobTitle: site.role,
        worksFor: { '@type': 'Organization', name: site.org },
        alumniOf: [
          { '@type': 'CollegeOrUniversity', name: 'Massachusetts Institute of Technology' },
          { '@type': 'CollegeOrUniversity', name: 'Johns Hopkins University' },
        ],
        sameAs: [site.links.scholar, site.links.github, site.links.linkedin].filter(Boolean),
      })}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="inner">
        <a href="/" class="brand plain-link">{site.name}</a>
        <nav aria-label="Primary">
          <a href="/" aria-current={nav === 'home' ? 'page' : undefined}>Homepage</a>
          <a href="/blog/" aria-current={nav === 'blog' ? 'page' : undefined}>Blog</a>
          <a href={site.links.scholar}>Publications</a>
        </nav>
        <span class="spacer"></span>
        <button type="button" data-theme-toggle class="toggle" aria-label="Toggle dark mode">
          <Icon name="moon" size={15} />
          <Icon name="sun" size={15} />
        </button>
      </div>
    </header>

    <slot />

    <script is:inline>
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-theme-toggle]');
        if (!t) return;
        var html = document.documentElement;
        html.classList.toggle('dark');
        try {
          localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        } catch (err) {}
      });
    </script>
  </body>
</html>
