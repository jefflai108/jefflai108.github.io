---
import data from '../data/contributions.json';
import { site } from '../data/site';

type Day = { date: string; count: number; level?: number };
const weeks: Day[][] = (data.weeks as Day[][]) ?? [];
const total: number = data.total ?? 0;

// Levels come from GitHub itself (contributionLevel), so the shading matches
// the profile page exactly. Snapshots written before that field was fetched
// have no `level`, so derive one the way GitHub does — quartiles of the
// distribution of active days.
//
// NOT max/4: with a 202-contribution day in the set, quarters of the *range*
// start at 50, so every ordinary day collapses into the lightest shade and the
// graph reads as flat. Quartiles of the *distribution* split by rank instead,
// which is what makes the depth mean anything.
const counts = weeks.flat().map((d) => d.count).filter((n) => n > 0).sort((a, b) => a - b);
const at = (p: number) => counts[Math.min(counts.length - 1, Math.floor(counts.length * p))] ?? 0;
const [q1, q2, q3] = [at(0.25), at(0.5), at(0.75)];
const derive = (n: number) => (n <= 0 ? 0 : n <= q1 ? 1 : n <= q2 ? 2 : n <= q3 ? 3 : 4);
const level = (d: Day) => d.level ?? derive(d.count);

const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const LEFT = 26; // room for day-of-week labels
const TOP = 14; // room for month labels
const width = LEFT + weeks.length * STEP;
const height = TOP + 7 * STEP;

// A month label sits above the first week that starts a new month.
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthLabels: { x: number; label: string }[] = [];
let lastMonth = -1;
weeks.forEach((week, i) => {
  const first = week[0];
  if (!first) return;
  const m = new Date(first.date + 'T00:00:00Z').getUTCMonth();
  if (m !== lastMonth) {
    lastMonth = m;
    monthLabels.push({ x: LEFT + i * STEP, label: MONTHS[m] });
  }
});

const dayLabels = [
  { y: TOP + 1 * STEP + 9, label: 'Mon' },
  { y: TOP + 3 * STEP + 9, label: 'Wed' },
  { y: TOP + 5 * STEP + 9, label: 'Fri' },
];

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

{
  weeks.length > 0 && (
    <section class="gh" id="activity">
      <div class="gh-meta">
        <span class="lbl">GITHUB</span>
        <span>{total.toLocaleString('en-US')} contributions in the past year</span>
        <a href={site.links.github}>@jefflai108</a>
      </div>

      <div class="gh-canvas">
        <svg
          viewBox={`0 0 ${width} ${height}`}
          width={width}
          height={height}
          role="img"
          aria-label={`GitHub contribution graph: ${total} contributions in the past year`}
        >
          {monthLabels.map((m) => (
            <text class="ml" x={m.x} y={9}>
              {m.label}
            </text>
          ))}
          {dayLabels.map((d) => (
            <text class="dl" x={0} y={d.y}>
              {d.label}
            </text>
          ))}
          {weeks.map((week, wi) =>
            week.map((day) => {
              const di = new Date(day.date + 'T00:00:00Z').getUTCDay();
              return (
                <rect
                  class="c"
                  data-l={level(day)}
                  x={LEFT + wi * STEP}
                  y={TOP + di * STEP}
                  width={CELL}
                  height={CELL}
                  rx={2}
                >
                  <title>
                    {day.count} contribution{day.count === 1 ? '' : 's'} on {fmt(day.date)}
                  </title>
                </rect>
              );
            })
          )}
        </svg>
      </div>

      <div class="gh-foot">
        <span class="scale">
          <span>less</span>
          <i data-l="0" />
          <i data-l="1" />
          <i data-l="2" />
          <i data-l="3" />
          <i data-l="4" />
          <span>more</span>
        </span>
      </div>
    </section>
  )
}
